# Copy to .env and fill in only what you need. / .env로 복사해 필요한 값만 채우세요.

# Default engine / 기본 엔진: ollama | gemini | openai
LYRICS_BACKEND=ollama

# Ollama (local / 로컬)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Gemini free tier / 무료 티어 — key: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI-compatible API / OpenAI 호환 API (Groq, OpenRouter, LM Studio, ...)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile

# Optional / 선택
# LYRICS_CACHE=~/.lyrics-jikdok/cache.db
# HOST=0.0.0.0
